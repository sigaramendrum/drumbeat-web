#!/usr/bin/env bash
# Block internal references in a commit message on this PUBLIC repo.
#
# WHY A SECOND HOOK. gitleaks scans diffs, not commit messages, so the rules in
# .gitleaks.toml cannot see this. A commit message is the worse of the two to get
# wrong: it cannot be edited after a push, and it renders on the public commit
# list. Branch names have the same property and end up inside merge commit
# subjects, which is why the pattern below catches them there too.
#
# This is prevention, not detection. CI never sees a message, so if one gets
# pushed the only honest description is "published".
#
# Activate with:  git config core.hooksPath .githooks
# Keep the patterns in step with the internal-reference rules in .gitleaks.toml.
set -eu

MSG_FILE="$1"

# Same three patterns as .gitleaks.toml, same reasoning: case-insensitive, and
# the separator class carries the unicode dashes that look like a hyphen.
#
# NOTE THE THIRD ONE HAS NO SPACE AND NO `?`, unlike the first two, and must stay that way.
# The product is called Drumbeat and this is its landing page, so "the Drumbeat app" is
# ordinary copy. With a space in the class this hook blocked the very commit that added it,
# for quoting that phrase as an example — which is how the inconsistency was found. A
# repository name is written with a hyphen or an underscore; prose is not.
PATTERN='(SIG[-‐‑–—_ ]?[0-9]{1,4}|ADR[-‐‑–—_ ]?[0-9]{2,3}|drumbeat[-‐‑–—_]app)'

# Test the captured text, not the pipeline's exit status. `grep | sort` returns sort's
# status, which is 0 whether or not grep matched, so `if hits=$(...); then` is always
# true and blocks every commit. That is how the first version of this hook behaved.
hits=$(grep -Eio "$PATTERN" "$MSG_FILE" | sort -u || true)

if [ -n "$hits" ]; then
  echo "X internal reference in the commit message - commit blocked" >&2
  echo "$hits" | sed 's/^/    /' >&2
  echo "" >&2
  echo "    This repo is public. A commit message cannot be edited after a push," >&2
  echo "    so this has to come out now rather than later." >&2
  echo "    Describe the change instead of naming the internal reference." >&2
  exit 1
fi

exit 0
